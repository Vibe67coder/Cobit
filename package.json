{
  "name": "cobitx",
  "private": true,
  "version": "15.1.0",
  "license": "UNLICENSED",
  "author": "David Joia",
  "description": "CobitX Estimating & Construction Takeoff Desktop Suite (.exe)",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron && tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "package:win": "npm run build:electron && electron-builder --config electron/builder.config.yml --win",
    "package:linux": "npm run build:electron && electron-builder --config electron/builder.config.yml --linux",
    "engine:start": "engine/.venv/bin/python engine/main.py --port 47820",
    "engine:mcp": "engine/.venv/bin/python engine/main.py --stdio-mcp",
    "lint": "oxlint",
    "test": "node --test tests/estimateCalc.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
